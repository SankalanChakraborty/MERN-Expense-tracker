# Copy to .env for local development. On Render, set these as Environment Variables.

# Port to listen on. Render injects this automatically — do not set it there.
PORT=8080

# MongoDB Atlas connection string.
# Atlas > Network Access must allow 0.0.0.0/0, because Render's egress IP is dynamic.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expensely

# Two DIFFERENT long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_ACCESS_TOKEN=
JWT_SECRET_REFRESH_TOKEN=

# "development" or "production".
# production turns on `secure` cookies, which require HTTPS, and enables the
# login/register rate limiters (they are skipped in development).
NODE_ENV=development

# Comma-separated origins allowed to call the API directly with credentials.
# With the Vercel rewrite in place, browser traffic is same-origin and never
# hits CORS — this is a safety net. Include your Vercel URL in production.
# e.g. CLIENT_ORIGINS=https://expensely.vercel.app,https://www.yourdomain.com
CLIENT_ORIGINS=http://localhost:5173

# --- Email (OTP verification) ----------------------------------------------
# Any SMTP provider works. Values below are Brevo (300/day free, no domain).
# Without these, registration fails in production; in development the code is
# printed to the server console instead of being emailed.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expensely" <your-verified-sender@example.com>

# Number of proxy hops to trust for client-IP resolution (rate limiting).
# Leave unset locally. On Render behind Vercel's rewrite, start with 1 and
# verify at GET /api/v1/health that `clientIp` is a real visitor IP, not a
# proxy address. If every visitor shares one IP, increase it.
# TRUST_PROXY=1
